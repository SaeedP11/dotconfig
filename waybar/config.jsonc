{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 6,
  "margin-top": 6,
  "margin-bottom": 6,
  "margin-left": 6,
  "margin-right": 6,
  
  "modules-left": ["custom/launcher", "cpu", "memory", "disk"],
  "modules-center": ["custom/date", "custom/time"],
  "modules-right": ["tray", "pulseaudio", "network", "bluetooth", "battery", "custom/power"],
  
  "custom/launcher": {
    "format": "<span size='x-large'></span>",
    "tooltip": false,
    "on-click": "fuzzel",
    "on-click-right": "niri msg action toggle-overview"
  },
  
  "cpu": {
    "interval": 5,
    "format": "<span font_size='x-large'>󰍛</span>   {usage:02}%",
    "on-click-right": "gnome-system-monitor"
  },
  
  "memory": {
    "format": "<span size='x-large'>󰘚</span>   {percentage:02}%",
    "on-click": "gnome-system-monitor",
    "interval": 5
  },


  "disk": {
    "format": "<span size='x-large'>󰋊</span>   {used} / {total}",
    "path": "/",
    "on-click": "baobab",
    "interval": 30
  }, 

  
  "custom/date": {
    "exec": "date '+%Y %b %d %a'",
    "format": "<span size='large'></span>   {}",
    "tooltip": false,
    "on-click": "gnome-calendar",
    "interval": 1
  },

  "custom/time": {
    "exec": "date '+%H:%M'",
    "format": "<span size='large'></span>   {}",
    "tooltip": false,
    "on-click": "gnome-clocks",
    "interval": 1
  },
  
  "tray": {
    "icon-size": 20,
    "spacing": 8
  },

  "pulseaudio": {
    "format": "<span size='x-large'>{icon}</span>   {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  
  "network": {
    "format-wifi": "<span size='large'>󰖩</span>",
    "format-ethernet": "<span size='large'>󰈀</span>",
    "format-disconnected": "<span size='large'>󰖪</span>",
    "tooltip-format": "{essid} ({signalStrength}%)"
  },
  
  "bluetooth": {
    "format": "<span size='x-large'>󰂯</span>",
    "format-disabled": "<span size='x-large'></span>",
    "format-connected": "<span size='x-large'>󰂱</span>",
    "on-click": "blueman-manager"
  },
  
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='x-large'>{icon}</span>   {capacity}%",
    "format-charging": "<span size='x-large'>󰂄</span>   {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  
  "custom/power": {
    "format": "<span size='large'>⏻</span>",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
